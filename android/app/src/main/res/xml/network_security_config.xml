<?xml version="1.0" encoding="utf-8"?>
<!-- Inline images and media in chat can be plain http:// links. IRC itself runs in the Go
     core and isn't affected by this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
