<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by default; values-night/themes.xml is the dark one. (Theme.DeviceDefault.DayNight
         would do both but only exists from Android 10, and minSdk is 8.) -->
    <style name="Theme.IRChatterbox" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>
</resources>
