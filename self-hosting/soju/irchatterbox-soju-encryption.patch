diff --git a/user_encrypt.go b/user_encrypt.go
new file mode 100644
index 0000000..94490d1
--- /dev/null
+++ b/user_encrypt.go
@@ -0,0 +1,183 @@
+package soju
+
+// IRChatterbox addition: per-user encryption of stored message text. See msgstore/encrypt.go.
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"filippo.io/age"
+	"gopkg.in/irc.v4"
+
+	"codeberg.org/emersion/soju/msgstore"
+)
+
+type encryptingStore interface {
+	SetEncryption(func(networkID int64) age.Recipient)
+}
+
+// recipientFor is the key a network's messages are stored with: its own, else the user's, else none.
+func (u *user) recipientFor(networkID int64) *age.X25519Recipient {
+	if m := u.netKeys.Load(); m != nil {
+		if r, ok := (*m)[networkID]; ok {
+			return r
+		}
+	}
+	return u.encRecipient.Load()
+}
+
+// networkKeyOwn reports whether a network has its own key (rather than the user's).
+func (u *user) networkKeyOwn(networkID int64) bool {
+	if m := u.netKeys.Load(); m != nil {
+		_, ok := (*m)[networkID]
+		return ok
+	}
+	return false
+}
+
+// initEncryption loads the user's public key and points the message store at it.
+func (u *user) initEncryption() {
+	es, ok := u.msgStore.(encryptingStore)
+	if !ok {
+		return
+	}
+	es.SetEncryption(func(networkID int64) age.Recipient {
+		if r := u.recipientFor(networkID); r != nil {
+			return r
+		}
+		return nil
+	})
+	if u.ID == 0 {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	nets, err := u.srv.db.ListNetworkEncryptionKeys(ctx, u.ID)
+	if err != nil {
+		u.logger.Printf("failed to load network encryption keys: %v", err)
+	}
+	m := map[int64]*age.X25519Recipient{}
+	for id, s := range nets {
+		if r, err := msgstore.ParseRecipient(s); err == nil {
+			m[id] = r
+		} else {
+			u.logger.Printf("stored encryption key for network %d is invalid: %v", id, err)
+		}
+	}
+	u.netKeys.Store(&m)
+
+	s, err := u.srv.db.GetEncryptionKey(ctx, u.ID)
+	if err != nil {
+		u.logger.Printf("failed to load encryption key: %v", err)
+		return
+	}
+	if s == "" {
+		return
+	}
+	r, err := msgstore.ParseRecipient(s)
+	if err != nil {
+		u.logger.Printf("stored encryption key is invalid: %v", err)
+		return
+	}
+	u.encRecipient.Store(r)
+}
+
+func parseOptionalKey(key string) (*age.X25519Recipient, string, error) {
+	if key == "" {
+		return nil, "", nil
+	}
+	r, err := msgstore.ParseRecipient(key)
+	if err != nil {
+		return nil, "", err
+	}
+	return r, r.String(), nil
+}
+
+// encryptStored encrypts the stored history of the given networks with r, in the background.
+func (u *user) encryptStored(networkIDs []int64, r *age.X25519Recipient) {
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Hour)
+		defer cancel()
+		total := 0
+		for _, id := range networkIDs {
+			n, err := u.srv.db.TransformNetworkMessages(ctx, id, func(msg *irc.Message) (*irc.Message, bool, error) {
+				return msgstore.EncryptMessage(msg, r)
+			})
+			total += n
+			if err != nil {
+				u.logger.Printf("encrypting stored history of network %d stopped after %d messages: %v", id, n, err)
+				return
+			}
+		}
+		u.logger.Printf("encrypted %d stored messages", total)
+	}()
+}
+
+// setNetworkEncryptionKey gives one network its own key ("" = go back to the user's key).
+// Setting one encrypts that network's stored history in the background. Runs in the user goroutine.
+func (u *user) setNetworkEncryptionKey(ctx context.Context, net *network, key string) (string, error) {
+	if _, ok := u.msgStore.(encryptingStore); !ok {
+		return "", fmt.Errorf("encryption needs \"message-store db\" in the soju config")
+	}
+	r, key, err := parseOptionalKey(key)
+	if err != nil {
+		return "", err
+	}
+	if err := u.srv.db.StoreNetworkEncryptionKey(ctx, net.ID, key); err != nil {
+		return "", err
+	}
+	m := map[int64]*age.X25519Recipient{}
+	if old := u.netKeys.Load(); old != nil {
+		for id, v := range *old {
+			m[id] = v
+		}
+	}
+	if r == nil {
+		delete(m, net.ID)
+	} else {
+		m[net.ID] = r
+	}
+	u.netKeys.Store(&m)
+	name := net.GetName()
+	if r == nil {
+		if u.encRecipient.Load() != nil {
+			return fmt.Sprintf("network %q now uses your account's encryption key for new messages; older ones stay encrypted with the removed key", name), nil
+		}
+		return fmt.Sprintf("encryption key removed from network %q: new messages are stored unencrypted, older ones stay encrypted", name), nil
+	}
+	u.encryptStored([]int64{net.ID}, r)
+	return fmt.Sprintf("encryption key set for network %q: new messages are stored encrypted, and its stored history is being encrypted now", name), nil
+}
+
+// setEncryptionKey saves (or, with "", removes) the user's public key. Setting a key also
+// encrypts the history already stored, in the background. Returns a line for the reply.
+func (u *user) setEncryptionKey(ctx context.Context, key string) (string, error) {
+	if _, ok := u.msgStore.(encryptingStore); !ok {
+		return "", fmt.Errorf("encryption needs \"message-store db\" in the soju config")
+	}
+	var r *age.X25519Recipient
+	if key != "" {
+		var err error
+		if r, err = msgstore.ParseRecipient(key); err != nil {
+			return "", err
+		}
+		key = r.String()
+	}
+	if err := u.srv.db.StoreEncryptionKey(ctx, u.ID, key); err != nil {
+		return "", err
+	}
+	u.encRecipient.Store(r)
+	if r == nil {
+		return "encryption key removed: new messages are stored unencrypted (except on networks with their own key), older ones stay encrypted", nil
+	}
+	// networks with their own key keep it
+	var ids []int64
+	for _, net := range u.networks {
+		if !u.networkKeyOwn(net.ID) {
+			ids = append(ids, net.ID)
+		}
+	}
+	u.encryptStored(ids, r)
+	return "encryption key set: new messages are stored encrypted, and stored history is being encrypted now", nil
+}
