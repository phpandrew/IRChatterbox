diff --git a/msgstore/encrypt.go b/msgstore/encrypt.go
new file mode 100644
index 0000000..b5e757a
--- /dev/null
+++ b/msgstore/encrypt.go
@@ -0,0 +1,64 @@
+package msgstore
+
+// IRChatterbox addition: encrypt the text of stored messages with the user's age public key.
+//
+// Only what's written to disk changes. Live messages reach connected clients as usual; when a
+// stored one is replayed later (CHATHISTORY, backlog) it carries the age ciphertext in the
+// EncryptedTag message tag, and its text is a placeholder. A client holding the private key
+// decrypts the tag and shows the original text. The sender, target and time stay readable to
+// the bouncer, since it needs them to file and replay history.
+
+import (
+	"bytes"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"strings"
+
+	"filippo.io/age"
+	"gopkg.in/irc.v4"
+)
+
+const (
+	EncryptedTag         = "irchatterbox.com/enc"
+	EncryptedCap         = "irchatterbox.com/enc" // lets a client receive the tag without message-tags
+	EncryptedPlaceholder = "[encrypted message: add your private key in IRChatterbox to read it]"
+)
+
+// ParseRecipient checks an age X25519 public key (age1...).
+func ParseRecipient(s string) (*age.X25519Recipient, error) {
+	r, err := age.ParseX25519Recipient(strings.TrimSpace(s))
+	if err != nil {
+		return nil, fmt.Errorf("not a valid age public key (age1...): %v", err)
+	}
+	return r, nil
+}
+
+// EncryptMessage returns an encrypted copy of a PRIVMSG/NOTICE, or ok=false when there's
+// nothing to encrypt (other commands, no text, or already encrypted). msg itself is untouched.
+func EncryptMessage(msg *irc.Message, r age.Recipient) (out *irc.Message, ok bool, err error) {
+	if r == nil || (msg.Command != "PRIVMSG" && msg.Command != "NOTICE") || len(msg.Params) < 2 {
+		return msg, false, nil
+	}
+	if _, done := msg.Tags[EncryptedTag]; done {
+		return msg, false, nil
+	}
+	var buf bytes.Buffer
+	w, err := age.Encrypt(&buf, r)
+	if err != nil {
+		return nil, false, err
+	}
+	if _, err := io.WriteString(w, msg.Params[len(msg.Params)-1]); err != nil {
+		return nil, false, err
+	}
+	if err := w.Close(); err != nil {
+		return nil, false, err
+	}
+	out = msg.Copy()
+	if out.Tags == nil {
+		out.Tags = irc.Tags{}
+	}
+	out.Tags[EncryptedTag] = base64.RawStdEncoding.EncodeToString(buf.Bytes())
+	out.Params[len(out.Params)-1] = EncryptedPlaceholder
+	return out, true, nil
+}
