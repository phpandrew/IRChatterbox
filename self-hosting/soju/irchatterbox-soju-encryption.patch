diff --git a/user_encrypt.go b/user_encrypt.go
new file mode 100644
index 0000000..392d0f3
--- /dev/null
+++ b/user_encrypt.go
@@ -0,0 +1,88 @@
+package soju
+
+// IRChatterbox addition: per-user encryption of stored message text. See msgstore/encrypt.go.
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"filippo.io/age"
+	"gopkg.in/irc.v4"
+
+	"codeberg.org/emersion/soju/msgstore"
+)
+
+type encryptingStore interface {
+	SetEncryption(func() age.Recipient)
+}
+
+// initEncryption loads the user's public key and points the message store at it.
+func (u *user) initEncryption() {
+	es, ok := u.msgStore.(encryptingStore)
+	if !ok {
+		return
+	}
+	es.SetEncryption(func() age.Recipient {
+		if r := u.encRecipient.Load(); r != nil {
+			return r
+		}
+		return nil
+	})
+	if u.ID == 0 {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	s, err := u.srv.db.GetEncryptionKey(ctx, u.ID)
+	if err != nil {
+		u.logger.Printf("failed to load encryption key: %v", err)
+		return
+	}
+	if s == "" {
+		return
+	}
+	r, err := msgstore.ParseRecipient(s)
+	if err != nil {
+		u.logger.Printf("stored encryption key is invalid: %v", err)
+		return
+	}
+	u.encRecipient.Store(r)
+}
+
+// setEncryptionKey saves (or, with "", removes) the user's public key. Setting a key also
+// encrypts the history already stored, in the background. Returns a line for the reply.
+func (u *user) setEncryptionKey(ctx context.Context, key string) (string, error) {
+	if _, ok := u.msgStore.(encryptingStore); !ok {
+		return "", fmt.Errorf("encryption needs \"message-store db\" in the soju config")
+	}
+	var r *age.X25519Recipient
+	if key != "" {
+		var err error
