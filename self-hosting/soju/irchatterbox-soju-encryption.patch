diff --git a/database/encryptionkey.go b/database/encryptionkey.go
new file mode 100644
index 0000000..97600df
--- /dev/null
+++ b/database/encryptionkey.go
@@ -0,0 +1,185 @@
+package database
+
+// IRChatterbox addition: a per-user age public key ("recipient"). When a user has one, the
+// message store encrypts the text of stored PRIVMSG/NOTICE lines with it. The key lives in its
+// own table, created on demand, so the upstream schema and migration numbering are untouched.
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"time"
+
+	"gopkg.in/irc.v4"
+)
+
+const sqliteEncryptionKeySchema = `
+CREATE TABLE IF NOT EXISTS EncryptionKey (
+	user INTEGER PRIMARY KEY,
+	recipient TEXT NOT NULL,
+	updated TEXT NOT NULL,
+	FOREIGN KEY(user) REFERENCES User(id) ON DELETE CASCADE
+)`
+
+const postgresEncryptionKeySchema = `
+CREATE TABLE IF NOT EXISTS "EncryptionKey" (
+	"user" INTEGER PRIMARY KEY REFERENCES "User"(id) ON DELETE CASCADE,
+	recipient TEXT NOT NULL,
+	updated TIMESTAMP WITH TIME ZONE NOT NULL
+)`
+
+// MessageTransform rewrites one stored message. It returns false to leave the row as it is.
+type MessageTransform func(msg *irc.Message) (*irc.Message, bool, error)
+
+func (db *SqliteDB) ensureEncryptionKeyTable(ctx context.Context) error {
+	_, err := db.db.ExecContext(ctx, sqliteEncryptionKeySchema)
+	return err
+}
+
+func (db *SqliteDB) GetEncryptionKey(ctx context.Context, userID int64) (string, error) {
+	ctx, cancel := context.WithTimeout(ctx, sqliteQueryTimeout)
+	defer cancel()
+	if err := db.ensureEncryptionKeyTable(ctx); err != nil {
+		return "", err
+	}
+	var r string
+	err := db.db.QueryRowContext(ctx, `SELECT recipient FROM EncryptionKey WHERE user = ?`, userID).Scan(&r)
+	if errors.Is(err, sql.ErrNoRows) {
+		return "", nil
+	}
+	return r, err
+}
+
+func (db *SqliteDB) StoreEncryptionKey(ctx context.Context, userID int64, recipient string) error {
+	ctx, cancel := context.WithTimeout(ctx, sqliteQueryTimeout)
+	defer cancel()
+	if err := db.ensureEncryptionKeyTable(ctx); err != nil {
+		return err
+	}
+	if recipient == "" {
+		_, err := db.db.ExecContext(ctx, `DELETE FROM EncryptionKey WHERE user = ?`, userID)
+		return err
+	}
+	_, err := db.db.ExecContext(ctx, `
+		INSERT INTO EncryptionKey(user, recipient, updated) VALUES (?, ?, ?)
+		ON CONFLICT(user) DO UPDATE SET recipient = excluded.recipient, updated = excluded.updated`,
+		userID, recipient, sqliteTime{time.Now()})
+	return err
+}
+
+// TransformUserMessages rewrites every stored message of a user's networks, in batches so the
+// bouncer stays responsive. Afterwards it merges the full-text index and checkpoints the WAL so
+// the old text doesn't linger in the database files (secure_delete zeroes freed space).
+func (db *SqliteDB) TransformUserMessages(ctx context.Context, userID int64, transform MessageTransform) (int, error) {
+	const batch = 500
+	changed := 0
+	lastID := int64(0)
+	for {
+		rows, err := db.db.QueryContext(ctx, `
+			SELECT m.id, m.raw FROM Message m
+			JOIN MessageTarget t ON t.id = m.target
+			JOIN Network n ON n.id = t.network
+			WHERE n.user = ? AND m.id > ?
+			ORDER BY m.id LIMIT ?`, userID, lastID, batch)
+		if err != nil {
+			return changed, err
+		}
+		type row struct {
+			id  int64
+			raw string
+		}
+		var list []row
+		for rows.Next() {
+			var r row
+			if err := rows.Scan(&r.id, &r.raw); err != nil {
+				rows.Close()
+				return changed, err
+			}
+			list = append(list, r)
+		}
+		rows.Close()
+		if err := rows.Err(); err != nil {
+			return changed, err
+		}
+		if len(list) == 0 {
+			break
+		}
+
+		tx, err := db.db.BeginTx(ctx, nil)
+		if err != nil {
+			return changed, err
+		}
+		for _, r := range list {
+			lastID = r.id
+			msg, err := irc.ParseMessage(r.raw)
+			if err != nil {
+				continue
+			}
+			out, ok, err := transform(msg)
+			if err != nil {
+				tx.Rollback()
+				return changed, err
+			}
+			if !ok {
+				continue
+			}
+			var text sql.NullString
+			if (out.Command == "PRIVMSG" || out.Command == "NOTICE") && len(out.Params) > 1 {
+				text = sql.NullString{String: stripANSI(out.Params[1]), Valid: true}
+			}
+			if _, err := tx.ExecContext(ctx, `UPDATE Message SET raw = ?, text = ? WHERE id = ?`, out.String(), text, r.id); err != nil {
+				tx.Rollback()
+				return changed, err
+			}
+			changed++
+		}
+		if err := tx.Commit(); err != nil {
+			return changed, err
+		}
+	}
+	if changed > 0 {
+		if _, err := db.db.ExecContext(ctx, `INSERT INTO MessageFTS(MessageFTS) VALUES ('optimize')`); err != nil {
+			return changed, fmt.Errorf("optimize search index: %w", err)
+		}
+		if _, err := db.db.ExecContext(ctx, `PRAGMA wal_checkpoint(TRUNCATE)`); err != nil {
+			return changed, fmt.Errorf("checkpoint: %w", err)
+		}
+	}
+	return changed, nil
+}
+
+func (db *PostgresDB) GetEncryptionKey(ctx context.Context, userID int64) (string, error) {
+	ctx, cancel := context.WithTimeout(ctx, postgresQueryTimeout)
+	defer cancel()
+	if _, err := db.db.ExecContext(ctx, postgresEncryptionKeySchema); err != nil {
+		return "", err
+	}
+	var r string
+	err := db.db.QueryRowContext(ctx, `SELECT recipient FROM "EncryptionKey" WHERE "user" = $1`, userID).Scan(&r)
+	if errors.Is(err, sql.ErrNoRows) {
+		return "", nil
+	}
+	return r, err
+}
+
+func (db *PostgresDB) StoreEncryptionKey(ctx context.Context, userID int64, recipient string) error {
+	ctx, cancel := context.WithTimeout(ctx, postgresQueryTimeout)
+	defer cancel()
+	if _, err := db.db.ExecContext(ctx, postgresEncryptionKeySchema); err != nil {
+		return err
+	}
+	if recipient == "" {
+		_, err := db.db.ExecContext(ctx, `DELETE FROM "EncryptionKey" WHERE "user" = $1`, userID)
+		return err
+	}
+	_, err := db.db.ExecContext(ctx, `
+		INSERT INTO "EncryptionKey"("user", recipient, updated) VALUES ($1, $2, NOW())
+		ON CONFLICT ("user") DO UPDATE SET recipient = EXCLUDED.recipient, updated = EXCLUDED.updated`,
+		userID, recipient)
+	return err
+}
+
+func (db *PostgresDB) TransformUserMessages(ctx context.Context, userID int64, transform MessageTransform) (int, error) {
+	return 0, errors.New("encrypting existing history is only supported with the SQLite database")
+}
